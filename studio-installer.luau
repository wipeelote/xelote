add("ReplicatedStorage.DebrisClear", "ModuleScript", "Ballistics", [=====[
--!strict
-- Throw math shared by the server (authoritative launch) and the client (aim
-- preview), so the preview arc matches what the server actually does.

local Config = require(script.Parent.Config)

local Ballistics = {}

-- Gravity felt by debris (see Config.DEBRIS_GRAVITY_SCALE).
function Ballistics.debrisGravity(): number
	return workspace.Gravity * Config.DEBRIS_GRAVITY_SCALE
end

-- Launch velocity of magnitude `speed` from `origin` that lands on `target`,
-- preferring the flatter arc. Returns (velocity, reachable). When the target is
-- out of range it aims toward it at Config.THROW_FALLBACK_PITCH.
function Ballistics.solve(origin: Vector3, target: Vector3, speed: number): (Vector3, boolean)
	local g = Ballistics.debrisGravity()
	local delta = target - origin
	local flat = Vector3.new(delta.X, 0, delta.Z)
	local x = flat.Magnitude
	if x < 0.05 then
		local dir = if delta.Magnitude > 0.05 then delta.Unit else Vector3.yAxis
		return dir * speed, true
	end
	local y = delta.Y
	local v2 = speed * speed
	local disc = v2 * v2 - g * (g * x * x + 2 * y * v2)
	local pitch
	local reachable = true
	if g <= 0 then
		pitch = math.atan2(y, x)
	elseif disc >= 0 then
		pitch = math.atan((v2 - math.sqrt(disc)) / (g * x))
	else
		pitch = Config.THROW_FALLBACK_PITCH
		reachable = false
	end
	return flat.Unit * (speed * math.cos(pitch)) + Vector3.yAxis * (speed * math.sin(pitch)), reachable
end

function Ballistics.positionAt(origin: Vector3, velocity: Vector3, t: number): Vector3
	return origin + velocity * t - Vector3.yAxis * (0.5 * Ballistics.debrisGravity() * t * t)
end

return Ballistics
]=====])
add("ReplicatedStorage.DebrisClear", "ModuleScript", "DecahedronMesh", [=====[
--!strict
-- Pentagonal trapezohedron (the d10 die shape) built with EditableMesh.
--
-- Geometry: two apexes at +/-h on the Y axis and a zig-zag belt of 10 vertices,
-- 5 "upper" at height +z (every 72 degrees) and 5 "lower" at -z (offset 36
-- degrees). All 10 faces are planar kites when h = z * (1 + cos36) / (1 - cos36).

local AssetService = game:GetService("AssetService")

local Config = require(script.Parent.Config)

local DecahedronMesh = {}

export type Kite = { Vector3 } -- 4 corners, outward-facing CCW order

-- Returns the 10 kite faces for a d10 of the given width (belt diameter).
function DecahedronMesh.kites(size: number): { Kite }
	local r = size / 2
	local c = math.cos(math.rad(36))
	local h = r -- apex height == belt radius gives a die about as tall as it is wide
	local z = h * (1 - c) / (1 + c)

	local top = Vector3.new(0, h, 0)
	local bottom = Vector3.new(0, -h, 0)
	local upper, lower = {}, {}
	for k = 0, 4 do
		local au = math.rad(72 * k)
		local al = math.rad(72 * k + 36)
		upper[k] = Vector3.new(math.cos(au) * r, z, math.sin(au) * r)
		lower[k] = Vector3.new(math.cos(al) * r, -z, math.sin(al) * r)
	end

	local kites: { Kite } = {}
	for k = 0, 4 do
		local k1 = (k + 1) % 5
		table.insert(kites, { top, upper[k], lower[k], upper[k1] })
		table.insert(kites, { bottom, lower[k], upper[k1], lower[k1] })
	end

	-- Normalise winding so (b - a) x (c - a) points away from the origin, which is
	-- the front face for Roblox's right-handed, counter-clockwise convention.
	for _, kite in kites do
		local n = (kite[2] - kite[1]):Cross(kite[3] - kite[1])
		local centroid = (kite[1] + kite[2] + kite[3] + kite[4]) / 4
		local outward = n:Dot(centroid) > 0
		if outward == Config.DEBRIS_FLIP_WINDING then
			kite[2], kite[4] = kite[4], kite[2]
		end
	end

	return kites
end

-- Builds a MeshPart from an EditableMesh. Returns nil (and warns) if
-- EditableMesh isn't available in this context, e.g. the place owner isn't
-- eligible or the memory budget is exhausted.
function DecahedronMesh.createMeshPart(size: number): MeshPart?
	local ok, result = pcall(function()
		local em = AssetService:CreateEditableMesh()
		for _, kite in DecahedronMesh.kites(size) do
			local ids = {}
			for i, v in kite do
				ids[i] = em:AddVertex(v)
			end
			local normal = (kite[2] - kite[1]):Cross(kite[3] - kite[1]).Unit
			local f1 = em:AddTriangle(ids[1], ids[2], ids[3])
			local f2 = em:AddTriangle(ids[1], ids[3], ids[4])
			-- Flat shading: give every corner of the kite the kite's normal.
			-- Wrapped separately so older EditableMesh APIs still produce a mesh.
			pcall(function()
				local nid = em:AddNormal(normal)
				em:SetFaceNormals(f1, { nid, nid, nid })
				em:SetFaceNormals(f2, { nid, nid, nid })
			end)
		end
		return AssetService:CreateMeshPartAsync(Content.fromObject(em), {
			CollisionFidelity = Enum.CollisionFidelity.Hull, -- d10 is convex, so the hull is exact
		})
	end)
	if not ok then
		warn(`[DebrisClear] EditableMesh d10 unavailable, using fallback shape: {result}`)
		return nil
	end
	-- EditableMesh vertices are already in studs, so leave Size at its natural bounds.
	return result :: MeshPart
end

-- Builds a MeshPart from an uploaded mesh asset id ("rbxassetid://...").
function DecahedronMesh.createFromAsset(assetId: string, size: number): MeshPart?
	local ok, result = pcall(function()
		return AssetService:CreateMeshPartAsync(Content.fromUri(assetId), {
			CollisionFidelity = Enum.CollisionFidelity.Hull,
		})
	end)
	if not ok then
		warn(`[DebrisClear] Could not load DEBRIS_MESH_ID {assetId}: {result}`)
		return nil
	end
	local part = result :: MeshPart
	part.Size = Vector3.new(size, size, size)
	return part
end

return DecahedronMesh
]=====])
add("ReplicatedStorage.DebrisClear", "ModuleScript", "HexGeometry", [=====[
--!strict
-- Regular hexagon math. Hexes are "pointy along local X": vertex i sits at
-- angle i * 60 degrees in the platform's local XZ plane.

local HexGeometry = {}

local SQRT3 = math.sqrt(3)

-- Local-space (X, Z) corners of a hexagon with circumradius `radius`.
function HexGeometry.corners(radius: number): { Vector2 }
	local out = {}
	for i = 0, 5 do
		local a = math.rad(60 * i)
		table.insert(out, Vector2.new(math.cos(a) * radius, math.sin(a) * radius))
	end
	return out
end

function HexGeometry.apothem(radius: number): number
	return radius * SQRT3 / 2
end

-- Is the local-space point (x, z) inside the hex?
function HexGeometry.containsLocal(radius: number, x: number, z: number): boolean
	local ax, az = math.abs(x), math.abs(z)
	return az <= radius * SQRT3 / 2 and SQRT3 * ax + az <= SQRT3 * radius
end

-- Is a world position over the hex whose center/orientation is `cf`?
-- Returns (inside, heightAboveCenter).
function HexGeometry.containsWorld(cf: CFrame, radius: number, worldPos: Vector3): (boolean, number)
	local p = cf:PointToObjectSpace(worldPos)
	return HexGeometry.containsLocal(radius, p.X, p.Z), p.Y
end

-- Uniform-ish random point inside the inscribed circle, scaled by `margin`.
function HexGeometry.randomLocalPoint(radius: number, margin: number, rng: Random): Vector2
	local r = HexGeometry.apothem(radius) * margin * math.sqrt(rng:NextNumber())
	local a = rng:NextNumber() * math.pi * 2
	return Vector2.new(math.cos(a) * r, math.sin(a) * r)
end

return HexGeometry
]=====])
add("ReplicatedStorage.DebrisClear", "ModuleScript", "Remotes", [=====[
--!strict
-- Single place that defines every RemoteEvent. The server creates them; clients
-- wait for them.
--
--   ThrowDebris  client -> server  (aimPoint: Vector3)
--   Knockback    server -> client  (velocity: Vector3, stunTime: number)
--   Effects      server -> all     (kind: string, position: Vector3, slot: number, extra: any?)
--                kinds: "Land"  a piece started counting on platform `slot`
--                       "Crush" platform `slot` was crushed
--                       "Win"   round over; extra = winner display name ("" if nobody)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "DebrisClearRemotes"
local NAMES = { "ThrowDebris", "Knockback", "Effects" }

local Remotes = {}

local function getFolder(): Folder
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME) :: Folder?
		if not folder then
			local created = Instance.new("Folder")
			created.Name = FOLDER_NAME
			for _, name in NAMES do
				local remote = Instance.new("RemoteEvent")
				remote.Name = name
				remote.Parent = created
			end
			created.Parent = ReplicatedStorage
			folder = created
		end
		return folder :: Folder
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

function Remotes.get(name: string): RemoteEvent
	return getFolder():WaitForChild(name) :: RemoteEvent
end

return Remotes
]=====])
add("ServerScriptService.DebrisClear", "Script", "Main", [=====[
--!strict
-- Debris Clear server entry point and round loop.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("DebrisClear")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Arena = require(script.Parent.Arena)
local MapKit = require(script.Parent.Map.MapKit)
local LoadService = require(script.Parent.LoadService)
local DebrisService = require(script.Parent.DebrisService)
local ThrowService = require(script.Parent.ThrowService)

Players.CharacterAutoLoads = false

Remotes.get("ThrowDebris") -- create the remotes before any client asks
local effectsRemote = Remotes.get("Effects")
Arena.build()
DebrisService.init()
ThrowService.init()

local roundActive = false

local function setStatus(text: string)
	ReplicatedStorage:SetAttribute("DebrisClearStatus", text)
	Arena.setBoardStatus(text)
end

---------------------------------------------------------------------------
-- Spawning: everyone lives on the hub unless a round puts them on a platform.
---------------------------------------------------------------------------
local function spawnInHub(player: Player)
	if player.Parent ~= Players then
		return
	end
	player:LoadCharacterAsync()
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	humanoid.Died:Connect(function()
		ThrowService.release(player)
		if roundActive then
			LoadService.eliminate(player, "Fell")
		end
		task.delay(Config.RESPAWN_DELAY, function()
			-- Only respawn if this is still the current character.
			if player.Character == character and not (roundActive and LoadService.isAlive(player)) then
				spawnInHub(player)
			end
		end)
	end)
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	spawnInHub(player)
end)
for _, player in Players:GetPlayers() do
	task.spawn(function()
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
		spawnInHub(player)
	end)
end

Players.PlayerRemoving:Connect(function(player)
	if roundActive then
		LoadService.eliminate(player, "Left")
	end
end)

LoadService.onEliminated(function(player, platform, reason)
	DebrisService.crushPlatform(platform)
	if roundActive then
		local verb = if reason == "Overloaded" then "was crushed" elseif reason == "Left" then "left" else "fell"
		setStatus(`{player.DisplayName} {verb}! {LoadService.aliveCount()} left`)
	end
end)

-- Only the pit kills. Below the kill line is death for anyone in the round or
-- anyone inside the arena column. Spectators who fall off the hub anywhere
-- else are put back on the hub instead.
RunService.Heartbeat:Connect(function()
	local killY = Arena.killY()
	local rescueY = Arena.hubFloorY - Config.HUB_RESCUE_DEPTH
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not (character and root and humanoid) or humanoid.Health <= 0 then
			continue
		end
		local position = root.Position
		local competing = roundActive and LoadService.isAlive(player)
		if position.Y < killY and (competing or Arena.inArenaColumn(position)) then
			humanoid.Health = 0
		elseif not competing and position.Y < rescueY and not Arena.inArenaColumn(position) then
			root.AssemblyLinearVelocity = Vector3.zero
			character:PivotTo(Arena.nearestSafeCFrame(position))
		end
	end
end)

---------------------------------------------------------------------------
-- Teleport pads (hub <-> showcase). Spectators only; competitors stay put.
---------------------------------------------------------------------------
local lastTeleport: { [Player]: number } = {}

local function bindTeleportPad(pad: Instance)
	if not pad:IsA("BasePart") then
		return
	end
	pad.Touched:Connect(function(hit)
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		if not player or not character then
			return
		end
		if roundActive and LoadService.isAlive(player) then
			return
		end
		local now = os.clock()
		if now - (lastTeleport[player] or 0) < Config.TELEPORT_COOLDOWN then
			return
		end
		local destination = Arena.destinationCFrame(tostring(pad:GetAttribute("Destination")))
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not destination or not root then
			return
		end
		lastTeleport[player] = now
		root.AssemblyLinearVelocity = Vector3.zero
		character:PivotTo(destination)
	end)
end

CollectionService:GetInstanceAddedSignal(MapKit.TELEPORT_TAG):Connect(bindTeleportPad)
for _, pad in CollectionService:GetTagged(MapKit.TELEPORT_TAG) do
	bindTeleportPad(pad)
end
Players.PlayerRemoving:Connect(function(player)
	lastTeleport[player] = nil
end)

---------------------------------------------------------------------------
-- Round loop
---------------------------------------------------------------------------
local function readyPlayers(): { Player }
	local out = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			table.insert(out, player)
		end
	end
	return out
end

local function intermission(): boolean
	for t = Config.INTERMISSION_TIME, 1, -1 do
		local count = #readyPlayers()
		if count < Config.MIN_PLAYERS then
			setStatus(`Waiting for players ({count}/{Config.MIN_PLAYERS})`)
			return false
		end
		setStatus(`Round starts in {t}`)
		task.wait(1)
	end
	return #readyPlayers() >= Config.MIN_PLAYERS
end

local function shuffle<T>(list: { T }): { T }
	local rng = Random.new()
	for i = #list, 2, -1 do
		local j = rng:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

local function setFrozen(players: { Player }, frozen: boolean)
	for _, player in players do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			root.Anchored = frozen
		end
	end
end

local function runRound()
	local participants = shuffle(readyPlayers())
	while #participants > Config.MAX_PLAYERS do
		table.remove(participants)
	end

	local assignments = {}
	local activePlatforms = {}
	for i, player in participants do
		local platform = Arena.platforms[i]
		assignments[player] = platform
		table.insert(activePlatforms, platform)
		local character = player.Character :: Model
		character:PivotTo(Arena.standCFrame(platform))
	end
	-- Unused platforms stay down for the round.
	for i = #participants + 1, #Arena.platforms do
		task.spawn(Arena.dropPlatform, Arena.platforms[i])
	end

	LoadService.startRound(assignments)
	roundActive = true
	setFrozen(participants, true)
	for t = Config.PRE_ROUND_COUNTDOWN, 1, -1 do
		setStatus(`Clear your platform! {t}`)
		task.wait(1)
	end
	setFrozen(participants, false)
	setStatus("GO!")
	DebrisService.startRound(activePlatforms)

	-- Solo test rounds end when the lone player is out; otherwise last one standing.
	local endAt = if #participants > 1 then 1 else 0
	while LoadService.aliveCount() > endAt do
		task.wait(0.2)
	end
	roundActive = false

	local winner = LoadService.alivePlayers()[1]
	setStatus(if winner then `{winner.DisplayName} wins!` else "Nobody survived!")
	-- Confetti + winner camera on every client; a slot of 0 means nobody won.
	local winnerPlatform = winner and LoadService.platformOf(winner)
	if winner and winnerPlatform then
		effectsRemote:FireAllClients("Win", winnerPlatform.topCFrame.Position, winnerPlatform.slot, winner.DisplayName)
	else
		effectsRemote:FireAllClients("Win", Config.ARENA_CENTER, 0, "")
	end
	ThrowService.releaseAll()
	DebrisService.stopRound()
	task.wait(Config.POST_ROUND_TIME)

	LoadService.reset()
	for _, platform in Arena.platforms do
		task.spawn(Arena.resetPlatform, platform)
	end
	for _, player in participants do
		if player.Parent == Players then
			task.spawn(spawnInHub, player)
		end
	end
end

while true do
	if intermission() then
		runRound()
	else
		task.wait(1)
	end
end
]=====])
add("ServerScriptService.DebrisClear", "ModuleScript", "Arena", [=====[
--!strict
-- Builds the arena: 4 hexagonal platforms on piston rods around a central pit,
-- with a ring-meter SurfaceGui on each deck. The surroundings (pit, towers,
-- spawn hub, showcase, lighting) are built by the modules in Map/.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("DebrisClear")
local Config = require(Shared.Config)
local HexGeometry = require(Shared.HexGeometry)
local Map = script.Parent.Map
local MapKit = require(Map.MapKit)
local Pit = require(Map.Pit)
local Towers = require(Map.Towers)
local Hub = require(Map.Hub)
local Showcase = require(Map.Showcase)
local MapLighting = require(Map.Lighting)
local PlatformDressing = require(Map.PlatformDressing)

local Arena = {}

export type Platform = {
	slot: number,
	model: Model,
	topCFrame: CFrame, -- center of the top surface, oriented with the hex
	restPivots: { [BasePart]: CFrame },
	dropped: boolean,
}

Arena.platforms = {} :: { Platform }
Arena.folder = nil :: Folder?
Arena.hubSpawn = nil :: SpawnLocation?
Arena.hubFloorY = 0
Arena.boardStatus = nil :: TextLabel?
Arena.showcaseSpawnCFrame = nil :: CFrame?

local PLATFORM_TAG = "DebrisClearPlatform"

local function anchoredPart(className: string, props: { [string]: any }): BasePart
	local part = Instance.new(className) :: BasePart
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(part :: any)[k] = v
	end
	return part
end

local function buildPlatform(slot: number, parent: Instance): Platform
	local angle = math.rad(45 + 90 * (slot - 1))
	local center = Config.ARENA_CENTER + Vector3.new(math.cos(angle), 0, math.sin(angle)) * Config.ARENA_RADIUS
	local flatCenter = Vector3.new(Config.ARENA_CENTER.X, center.Y, Config.ARENA_CENTER.Z)
	-- -Z faces the pit, so one flat hex edge faces inward.
	local topCFrame = CFrame.lookAt(center, flatCenter)
	local color = Config.PLATFORM_COLORS[slot] or Color3.new(0.7, 0.7, 0.7)

	local model = Instance.new("Model")
	model.Name = `Platform{slot}`

	local block = MapKit.hexDeck(topCFrame, Config.PLATFORM_RADIUS, Config.PLATFORM_THICKNESS, model, {
		Name = "Deck",
		Color = color,
		Material = Enum.Material.DiamondPlate,
	})
	model.PrimaryPart = block

	-- Piston rod the deck rides on, reaching down to the pit floor.
	local rodLength = Config.PIT_DEPTH - Config.PLATFORM_THICKNESS
	local rod = anchoredPart("Part", {
		Name = "PistonRod",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(rodLength, 6, 6),
		Color = Color3.fromRGB(70, 70, 78),
		Material = Enum.Material.Metal,
	})
	rod.CFrame = topCFrame * CFrame.new(0, -Config.PLATFORM_THICKNESS - rodLength / 2, 0) * CFrame.Angles(0, 0, math.rad(90))
	rod.Parent = model

	-- Visual dressing (rim, lights, slot number). Added before restPivots is
	-- collected so it rides the piston drop with the deck.
	PlatformDressing.dress(model, topCFrame, color, slot)

	MapKit.ringMeter(topCFrame, Config.PLATFORM_RADIUS, model)

	model:SetAttribute("Slot", slot)
	model:SetAttribute("Load", 0)
	model:SetAttribute("Capacity", Config.PLATFORM_CAPACITY)
	model:SetAttribute("OwnerName", "")
	model:SetAttribute("Eliminated", false)
	model.Parent = parent
	CollectionService:AddTag(model, PLATFORM_TAG)

	local restPivots = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			restPivots[d] = d.CFrame
		end
	end

	return {
		slot = slot,
		model = model,
		topCFrame = topCFrame,
		restPivots = restPivots,
		dropped = false,
	}
end

function Arena.build()
	local folder = Instance.new("Folder")
	folder.Name = "DebrisClearArena"

	-- Ours is the only enabled spawn, so nobody spawns inside the pit.
	for _, d in workspace:GetDescendants() do
		if d:IsA("SpawnLocation") then
			d.Enabled = false
		end
	end

	MapLighting.apply()
	Pit.build(folder)
	Towers.build(folder)

	local hub = Hub.build(folder)
	Arena.hubSpawn = hub.spawn
	Arena.boardStatus = hub.statusLabel
	Arena.hubFloorY = hub.floorY

	local showcase = Showcase.build(folder)
	Arena.showcaseSpawnCFrame = showcase.spawnCFrame

	for slot = 1, Config.MAX_PLAYERS do
		table.insert(Arena.platforms, buildPlatform(slot, folder))
	end
	local debris = Instance.new("Folder")
	debris.Name = "Debris"
	debris.Parent = folder
	folder.Parent = workspace
	Arena.folder = folder
end

function Arena.debrisFolder(): Folder
	return (Arena.folder :: Folder):FindFirstChild("Debris") :: Folder
end

function Arena.killY(): number
	return Config.ARENA_CENTER.Y - Config.KILL_DEPTH
end

-- Is this position horizontally inside the pit area, where the kill line applies?
function Arena.inArenaColumn(position: Vector3): boolean
	local c = Config.ARENA_CENTER
	local dx, dz = position.X - c.X, position.Z - c.Z
	return dx * dx + dz * dz <= Config.ARENA_KILL_RADIUS * Config.ARENA_KILL_RADIUS
end

-- Where to put someone who wandered off the hub.
function Arena.hubReturnCFrame(): CFrame
	local spawn = Arena.hubSpawn :: SpawnLocation
	return spawn.CFrame * CFrame.new(0, 3.5, 0)
end

-- Teleport pad destinations, by the pad's "Destination" attribute.
function Arena.destinationCFrame(name: string): CFrame?
	if name == "Hub" then
		return Arena.hubReturnCFrame()
	elseif name == "Showcase" then
		return Arena.showcaseSpawnCFrame
	end
	return nil
end

-- Closest safe spot (hub or showcase) to put a fallen spectator back on.
function Arena.nearestSafeCFrame(position: Vector3): CFrame
	local best = Arena.hubReturnCFrame()
	local showcase = Arena.showcaseSpawnCFrame
	if showcase then
		local function flatDistance(cf: CFrame): number
			return (Vector3.new(cf.X, 0, cf.Z) - Vector3.new(position.X, 0, position.Z)).Magnitude
		end
		if flatDistance(showcase) < flatDistance(best) then
			best = showcase
		end
	end
	return best
end

function Arena.setBoardStatus(text: string)
	local label = Arena.boardStatus
	if label then
		label.Text = text
	end
end

-- Standing spot for a player on a platform (slightly above the deck).
function Arena.standCFrame(platform: Platform): CFrame
	return platform.topCFrame * CFrame.new(0, 3.5, 0)
end

function Arena.isOver(platform: Platform, worldPos: Vector3): (boolean, number)
	return HexGeometry.containsWorld(platform.topCFrame, Config.PLATFORM_RADIUS, worldPos)
end

local function tweenModel(platform: Platform, offset: Vector3, info: TweenInfo)
	local last: Tween? = nil
	for part, rest in platform.restPivots do
		local tween = TweenService:Create(part, info, { CFrame = rest + offset })
		tween:Play()
		last = tween
	end
	if last then
		last.Completed:Wait()
	end
end

-- Piston drop (~0.3s by default). Yields until the drop finishes.
function Arena.dropPlatform(platform: Platform)
	if platform.dropped then
		return
	end
	platform.dropped = true
	local info = TweenInfo.new(Config.PISTON_DROP_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tweenModel(platform, Vector3.new(0, -Config.PISTON_DROP_DISTANCE, 0), info)
end

function Arena.resetPlatform(platform: Platform)
	platform.model:SetAttribute("Load", 0)
	platform.model:SetAttribute("OwnerName", "")
	platform.model:SetAttribute("Eliminated", false)
	if platform.dropped then
		platform.dropped = false
		local info = TweenInfo.new(Config.PISTON_RESET_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
		tweenModel(platform, Vector3.zero, info)
	end
end

return Arena
]=====])
add("ServerScriptService.DebrisClear", "ModuleScript", "DebrisService", [=====[
--!strict
-- Spawns d10 debris over each live platform, owns their physics, and decides
-- which platform (if any) each piece has landed on.
--
-- Every piece carries a replicated "State" attribute for client visuals:
--   "Loose"   falling, or resting somewhere that doesn't count
--   "Held"    welded to a player
--   "Thrown"  in flight after a throw, until it settles
--   "Landed"  counting toward a platform's load

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("DebrisClear")
local Config = require(Shared.Config)
local DecahedronMesh = require(Shared.DecahedronMesh)
local HexGeometry = require(Shared.HexGeometry)
local Remotes = require(Shared.Remotes)
local Arena = require(script.Parent.Arena)
local LoadService = require(script.Parent.LoadService)

type Platform = Arena.Platform

export type DebrisRecord = {
	part: BasePart,
	prompt: ProximityPrompt,
	antiGravity: VectorForce,
	landedOn: Platform?,
	heldBy: Player?,
	thrownBy: Player?,
	thrownAt: number,
	throwVelocity: Vector3,
	hitDone: boolean,
	-- Landing hysteresis: the platform the piece has been resting over since
	-- settleSince, and when a landed piece was first seen off its platform.
	settleOn: Platform?,
	settleSince: number,
	unsettleSince: number?,
	trail: Trail?,
	-- Flung off a crushed platform; never counts again.
	doomed: boolean,
}

local DEBRIS_TAG = "DebrisClearDebris"
local TRAIL_HALF_WIDTH = 0.8 -- studs from the piece center to each trail attachment
local CRUSH_SCATTER_SPREAD = 0.35 -- horizontal jitter per unit of downward fling
local CRUSH_SCATTER_SPIN = 10 -- rad/s of random tumble on a flung piece

local DebrisService = {}

local records: { [BasePart]: DebrisRecord } = {}
local template: BasePart? = nil
local rng = Random.new()
local roundId = 0
local roundStartedAt = 0
local scanAccumulator = 0
local effectsRemote: RemoteEvent

-- Set by ThrowService so this module doesn't need to require it.
DebrisService.onPromptTriggered = nil :: ((player: Player, part: BasePart) -> ())?
DebrisService.onDebrisTouched = nil :: ((record: DebrisRecord, hit: BasePart) -> ())?

local function buildTemplate(): BasePart
	local size = Config.DEBRIS_SIZE
	local part: BasePart? = nil
	local visual = "Server"

	if Config.DEBRIS_MESH_ID ~= "" then
		part = DecahedronMesh.createFromAsset(Config.DEBRIS_MESH_ID, size)
	end
	if not part then
		part = DecahedronMesh.createMeshPart(size)
		if part then
			-- EditableMesh geometry doesn't replicate, so the server part only
			-- supplies physics; each client draws its own d10 on top of it.
			visual = "Client"
		end
	end
	if not part then
		local ball = Instance.new("Part")
		ball.Shape = Enum.PartType.Ball
		ball.Size = Vector3.new(size, size, size)
		part = ball
		visual = "Client"
	end

	local p = part :: BasePart
	p.Name = "Debris"
	p.Color = Config.DEBRIS_COLOR
	p.Material = Config.DEBRIS_MATERIAL
	p.Transparency = if visual == "Client" then 1 else 0
	p.CustomPhysicalProperties = PhysicalProperties.new(
		Config.DEBRIS_DENSITY,
		Config.DEBRIS_FRICTION,
		Config.DEBRIS_ELASTICITY
	)
	p.Anchored = false
	p:SetAttribute("Visual", visual)

	local attachment = Instance.new("Attachment")
	attachment.Name = "Center"
	attachment.Parent = p

	-- Partial gravity cancel so a 60 stud/s throw can reach rival platforms.
	local force = Instance.new("VectorForce")
	force.Name = "AntiGravity"
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.ApplyAtCenterOfMass = true
	force.Attachment0 = attachment
	force.Parent = p

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "PickupPrompt"
	prompt.ActionText = "Pick up"
	prompt.ObjectText = "Debris"
	prompt.KeyboardKeyCode = Config.PICKUP_KEY
	prompt.GamepadKeyCode = Config.PICKUP_GAMEPAD_KEY
	-- Custom style: the engine still handles key/gamepad input and picks the
	-- closest prompt in range, but the client draws its own Grab button and
	-- highlight (see client InteractionController).
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.MaxActivationDistance = Config.PICKUP_RANGE
	prompt.HoldDuration = Config.PICKUP_HOLD_DURATION
	prompt.RequiresLineOfSight = false
	prompt.Parent = p
	return p
end

function DebrisService.init()
	template = buildTemplate()
	effectsRemote = Remotes.get("Effects")

	RunService.Heartbeat:Connect(function(dt)
		scanAccumulator += dt
		if scanAccumulator >= Config.LAND_SCAN_INTERVAL then
			scanAccumulator = 0
			DebrisService.scan()
		end
	end)
end

function DebrisService.get(part: BasePart): DebrisRecord?
	return records[part]
end

function DebrisService.count(): number
	local n = 0
	for _ in records do
		n += 1
	end
	return n
end

local function setState(record: DebrisRecord, state: string)
	record.part:SetAttribute("State", state)
end

local function clearTrail(record: DebrisRecord)
	local trail = record.trail
	if not trail then
		return
	end
	record.trail = nil
	local a0, a1 = trail.Attachment0, trail.Attachment1
	trail:Destroy()
	if a0 then
		a0:Destroy()
	end
	if a1 then
		a1:Destroy()
	end
end

-- Default ribbon (no texture) fading from the debris color to white.
local function attachTrail(record: DebrisRecord)
	clearTrail(record)
	local part = record.part
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailLeft"
	a0.Position = Vector3.new(TRAIL_HALF_WIDTH, 0, 0)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailRight"
	a1.Position = Vector3.new(-TRAIL_HALF_WIDTH, 0, 0)
	a1.Parent = part

	local trail = Instance.new("Trail")
	trail.Name = "ThrowTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = Config.THROW_TRAIL_LIFETIME
	trail.Color = ColorSequence.new(Config.DEBRIS_COLOR, Color3.new(1, 1, 1))
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.LightEmission = 0.5
	trail.FaceCamera = true
	trail.Parent = part
	record.trail = trail

	-- Safety net: a piece that never settles still loses its trail.
	task.delay(Config.THROW_HIT_WINDOW * 2, function()
		if record.trail == trail then
			clearTrail(record)
		end
	end)
end

-- Moves the piece's load between platforms. Callers set the "State" attribute.
local function setLanded(record: DebrisRecord, platform: Platform?)
	if record.landedOn == platform then
		return
	end
	if record.landedOn then
		LoadService.addLoad(record.landedOn, -Config.LOAD_PER_DEBRIS)
	end
	record.landedOn = platform
	record.unsettleSince = nil
	if platform then
		LoadService.addLoad(platform, Config.LOAD_PER_DEBRIS)
	end
end

-- The piece has sat still on a live platform long enough: count it.
local function land(record: DebrisRecord, platform: Platform)
	record.thrownBy = nil
	record.hitDone = true
	clearTrail(record)
	setLanded(record, platform)
	setState(record, "Landed")
	effectsRemote:FireAllClients("Land", record.part.Position, platform.slot)
end

function DebrisService.destroy(part: BasePart)
	local record = records[part]
	if record then
		clearTrail(record)
		setLanded(record, nil)
		records[part] = nil
	end
	part:Destroy()
end

local function updateAntiGravity(record: DebrisRecord)
	local part = record.part
	local lift = if record.heldBy or record.doomed
		then 0
		else part:GetMass() * workspace.Gravity * (1 - Config.DEBRIS_GRAVITY_SCALE)
	record.antiGravity.Force = Vector3.new(0, lift, 0)
end

function DebrisService.spawnAt(position: Vector3): BasePart?
	if not template or DebrisService.count() >= Config.MAX_DEBRIS_TOTAL then
		return nil
	end
	local part = (template :: BasePart):Clone()
	part.CFrame = CFrame.new(position)
		* CFrame.Angles(rng:NextNumber() * math.pi * 2, rng:NextNumber() * math.pi * 2, rng:NextNumber() * math.pi * 2)
	part:SetAttribute("State", "Loose")
	part.Parent = Arena.debrisFolder()
	part:SetNetworkOwner(nil) -- server-authoritative physics
	part.AssemblyAngularVelocity = rng:NextUnitVector() * 3

	local record: DebrisRecord = {
		part = part,
		prompt = part:FindFirstChild("PickupPrompt") :: ProximityPrompt,
		antiGravity = part:FindFirstChild("AntiGravity") :: VectorForce,
		landedOn = nil,
		heldBy = nil,
		thrownBy = nil,
		thrownAt = 0,
		throwVelocity = Vector3.zero,
		hitDone = true,
		settleOn = nil,
		settleSince = 0,
		unsettleSince = nil,
		trail = nil,
		doomed = false,
	}
	records[part] = record
	updateAntiGravity(record)
	CollectionService:AddTag(part, DEBRIS_TAG)

	record.prompt.Triggered:Connect(function(player)
		local handler = DebrisService.onPromptTriggered
		if handler then
			handler(player, part)
		end
	end)
	part.Touched:Connect(function(hit)
		local handler = DebrisService.onDebrisTouched
		if handler and record.thrownBy and not record.hitDone then
			handler(record, hit)
		end
	end)
	return part
end

-- Called by ThrowService when a player grabs a piece. Removes it from any
-- platform's load immediately.
function DebrisService.markHeld(record: DebrisRecord, player: Player)
	setLanded(record, nil)
	record.heldBy = player
	record.thrownBy = nil
	record.hitDone = true
	record.settleOn = nil
	clearTrail(record)
	record.prompt.Enabled = false
	record.part.CanCollide = false
	record.part.Massless = true
	updateAntiGravity(record)
	setState(record, "Held")
end

function DebrisService.markReleased(record: DebrisRecord, thrower: Player?, velocity: Vector3?)
	record.heldBy = nil
	record.settleOn = nil
	record.prompt.Enabled = true
	record.part.CanCollide = true
	record.part.Massless = false
	updateAntiGravity(record)
	if thrower and velocity then
		record.thrownBy = thrower
		record.thrownAt = os.clock()
		record.throwVelocity = velocity
		record.hitDone = false
		attachTrail(record)
		setState(record, "Thrown")
	else
		setState(record, "Loose")
	end
end

-- Which live platform is this position resting on, if any?
local function platformUnder(position: Vector3): Platform?
	for _, platform in Arena.platforms do
		if not platform.dropped and LoadService.isActive(platform) then
			local inside, height = Arena.isOver(platform, position)
			if inside and height >= -1 and height <= Config.LAND_HEIGHT_BAND then
				return platform
			end
		end
	end
	return nil
end

function DebrisService.scan()
	local killY = Arena.killY()
	local now = os.clock()
	for part, record in records do
		if not part.Parent then
			clearTrail(record)
			setLanded(record, nil)
			records[part] = nil
			continue
		end
		if record.heldBy then
			continue
		end
		local position = part.Position
		if position.Y < killY then
			DebrisService.destroy(part)
			continue
		end
		if record.doomed then
			continue
		end
		if record.thrownBy and now - record.thrownAt > Config.THROW_HIT_WINDOW then
			-- Too late to hit anyone.
			record.hitDone = true
		end
		-- "Thrown" lasts until the piece actually slows (or the trail's safety
		-- net expires), not just until the hit window closes.
		if part:GetAttribute("State") == "Thrown"
			and (part.AssemblyLinearVelocity.Magnitude <= Config.LAND_MAX_SPEED
				or now - record.thrownAt > Config.THROW_HIT_WINDOW * 2) then
			setState(record, "Loose")
		end

		-- Settle timer: how long the piece has sat still over one platform.
		local under = platformUnder(position)
		local resting = under ~= nil and part.AssemblyLinearVelocity.Magnitude <= Config.LAND_MAX_SPEED
		if not resting then
			record.settleOn = nil
		elseif under ~= record.settleOn then
			record.settleOn = under
			record.settleSince = now
		end

		-- Unsettle timer: how long a landed piece has been off its platform.
		local landedOn = record.landedOn
		if landedOn then
			if under == landedOn then
				record.unsettleSince = nil
			else
				local since = record.unsettleSince or now
				record.unsettleSince = since
				if now - since >= Config.LAND_UNSETTLE_TIME then
					-- Slid, rolled or got knocked off.
					setLanded(record, nil)
					setState(record, "Loose")
				end
			end
		end

		local settleOn = record.settleOn
		if not record.landedOn and settleOn and now - record.settleSince >= Config.LAND_SETTLE_TIME then
			land(record, settleOn)
		end
	end
end

-- Pressure curve: spawn gaps shrink from the start values to the *_END values
-- over SPAWN_RAMP_TIME, then hold.
local function nextSpawnInterval(): number
	local ramp = Config.SPAWN_RAMP_TIME
	local t = if ramp > 0 then math.clamp((os.clock() - roundStartedAt) / ramp, 0, 1) else 1
	local min = Config.SPAWN_INTERVAL_MIN + (Config.SPAWN_INTERVAL_MIN_END - Config.SPAWN_INTERVAL_MIN) * t
	local max = Config.SPAWN_INTERVAL_MAX + (Config.SPAWN_INTERVAL_MAX_END - Config.SPAWN_INTERVAL_MAX) * t
	return rng:NextNumber(min, max)
end

local function spawnLoop(platform: Platform, myRound: number)
	while roundId == myRound and LoadService.isActive(platform) do
		task.wait(nextSpawnInterval())
		if roundId ~= myRound or not LoadService.isActive(platform) then
			break
		end
		local offset = HexGeometry.randomLocalPoint(Config.PLATFORM_RADIUS, Config.SPAWN_EDGE_MARGIN, rng)
		local position = platform.topCFrame:PointToWorldSpace(Vector3.new(offset.X, Config.SPAWN_HEIGHT, offset.Y))
		DebrisService.spawnAt(position)
	end
end

function DebrisService.startRound(platforms: { Platform })
	roundId += 1
	roundStartedAt = os.clock()
	for _, platform in platforms do
		task.spawn(spawnLoop, platform, roundId)
	end
end

-- Flings a piece off a crushed platform into the lava. It never counts again;
-- the kill-line check in scan() destroys it once it drops below killY.
local function doom(record: DebrisRecord)
	setLanded(record, nil)
	record.doomed = true
	record.thrownBy = nil
	record.hitDone = true
	record.settleOn = nil
	clearTrail(record)
	setState(record, "Loose")
	record.prompt.Enabled = false
	updateAntiGravity(record)

	local part = record.part
	part.CanTouch = false
	local direction = Vector3.new(
		rng:NextNumber(-CRUSH_SCATTER_SPREAD, CRUSH_SCATTER_SPREAD),
		-1,
		rng:NextNumber(-CRUSH_SCATTER_SPREAD, CRUSH_SCATTER_SPREAD)
	).Unit
	part.AssemblyLinearVelocity = direction * Config.CRUSH_SCATTER_SPEED
	part.AssemblyAngularVelocity = rng:NextUnitVector() * CRUSH_SCATTER_SPIN
end

-- Scatters every loose piece over a crushed platform's footprint into the pit.
function DebrisService.crushPlatform(platform: Platform)
	for part, record in records do
		if record.heldBy or record.doomed then
			continue
		end
		local inside = HexGeometry.containsWorld(platform.topCFrame, Config.PLATFORM_RADIUS, part.Position)
		if record.landedOn == platform or inside then
			doom(record)
		end
	end
end

function DebrisService.stopRound()
	roundId += 1
	for part in records do
		DebrisService.destroy(part)
	end
end

return DebrisService
