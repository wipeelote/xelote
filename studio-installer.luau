add("ServerScriptService", "ModuleScript", "DebrisService", [=====[
--!strict
-- Spawns d10 debris over each live platform, owns their physics, and decides
-- which platform (if any) each piece has landed on.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("DebrisClear")
local Config = require(Shared.Config)
local DecahedronMesh = require(Shared.DecahedronMesh)
local HexGeometry = require(Shared.HexGeometry)
local Arena = require(script.Parent.Arena)
local LoadService = require(script.Parent.LoadService)

type Platform = Arena.Platform

export type DebrisRecord = {
	part: BasePart,
	prompt: ProximityPrompt,
	antiGravity: VectorForce,
	landedOn: Platform?,
	heldBy: Player?,
	thrownBy: Player?,
	thrownAt: number,
	throwVelocity: Vector3,
	hitDone: boolean,
}

local DEBRIS_TAG = "DebrisClearDebris"

local DebrisService = {}

local records: { [BasePart]: DebrisRecord } = {}
local template: BasePart? = nil
local rng = Random.new()
local roundId = 0
local scanAccumulator = 0

-- Set by ThrowService so this module doesn't need to require it.
DebrisService.onPromptTriggered = nil :: ((player: Player, part: BasePart) -> ())?
DebrisService.onDebrisTouched = nil :: ((record: DebrisRecord, hit: BasePart) -> ())?

local function buildTemplate(): BasePart
	local size = Config.DEBRIS_SIZE
	local part: BasePart? = nil
	local visual = "Server"

	if Config.DEBRIS_MESH_ID ~= "" then
		part = DecahedronMesh.createFromAsset(Config.DEBRIS_MESH_ID, size)
	end
	if not part then
		part = DecahedronMesh.createMeshPart(size)
		if part then
			-- EditableMesh geometry doesn't replicate, so the server part only
			-- supplies physics; each client draws its own d10 on top of it.
			visual = "Client"
		end
	end
	if not part then
		local ball = Instance.new("Part")
		ball.Shape = Enum.PartType.Ball
		ball.Size = Vector3.new(size, size, size)
		part = ball
		visual = "Client"
	end

	local p = part :: BasePart
	p.Name = "Debris"
	p.Color = Config.DEBRIS_COLOR
	p.Material = Config.DEBRIS_MATERIAL
	p.Transparency = if visual == "Client" then 1 else 0
	p.CustomPhysicalProperties = PhysicalProperties.new(
		Config.DEBRIS_DENSITY,
		Config.DEBRIS_FRICTION,
		Config.DEBRIS_ELASTICITY
	)
	p.Anchored = false
	p:SetAttribute("Visual", visual)

	local attachment = Instance.new("Attachment")
	attachment.Name = "Center"
	attachment.Parent = p

	-- Partial gravity cancel so a 60 stud/s throw can reach rival platforms.
	local force = Instance.new("VectorForce")
	force.Name = "AntiGravity"
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.ApplyAtCenterOfMass = true
	force.Attachment0 = attachment
	force.Parent = p

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "PickupPrompt"
	prompt.ActionText = "Pick up"
	prompt.ObjectText = "Debris"
	prompt.KeyboardKeyCode = Config.PICKUP_KEY
	prompt.GamepadKeyCode = Config.PICKUP_GAMEPAD_KEY
	-- Custom style: the engine still handles key/gamepad input and picks the
	-- closest prompt in range, but the client draws its own Grab button and
	-- highlight (see client InteractionController).
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.MaxActivationDistance = Config.PICKUP_RANGE
	prompt.HoldDuration = Config.PICKUP_HOLD_DURATION
	prompt.RequiresLineOfSight = false
	prompt.Parent = p
	return p
end

function DebrisService.init()
	template = buildTemplate()

	RunService.Heartbeat:Connect(function(dt)
		scanAccumulator += dt
		if scanAccumulator >= Config.LAND_SCAN_INTERVAL then
			scanAccumulator = 0
			DebrisService.scan()
		end
	end)
end

function DebrisService.get(part: BasePart): DebrisRecord?
	return records[part]
end

function DebrisService.count(): number
	local n = 0
	for _ in records do
		n += 1
	end
	return n
end

local function setLanded(record: DebrisRecord, platform: Platform?)
	if record.landedOn == platform then
		return
	end
	if record.landedOn then
		LoadService.addLoad(record.landedOn, -Config.LOAD_PER_DEBRIS)
	end
	record.landedOn = platform
	if platform then
		LoadService.addLoad(platform, Config.LOAD_PER_DEBRIS)
	end
end

function DebrisService.destroy(part: BasePart)
	local record = records[part]
	if record then
		setLanded(record, nil)
		records[part] = nil
	end
	part:Destroy()
end

local function updateAntiGravity(record: DebrisRecord)
	local part = record.part
	local lift = if record.heldBy then 0 else part:GetMass() * workspace.Gravity * (1 - Config.DEBRIS_GRAVITY_SCALE)
	record.antiGravity.Force = Vector3.new(0, lift, 0)
end

function DebrisService.spawnAt(position: Vector3): BasePart?
	if not template or DebrisService.count() >= Config.MAX_DEBRIS_TOTAL then
		return nil
	end
	local part = (template :: BasePart):Clone()
	part.CFrame = CFrame.new(position)
		* CFrame.Angles(rng:NextNumber() * math.pi * 2, rng:NextNumber() * math.pi * 2, rng:NextNumber() * math.pi * 2)
	part.Parent = Arena.debrisFolder()
	part:SetNetworkOwner(nil) -- server-authoritative physics
	part.AssemblyAngularVelocity = rng:NextUnitVector() * 3

	local record: DebrisRecord = {
		part = part,
		prompt = part:FindFirstChild("PickupPrompt") :: ProximityPrompt,
		antiGravity = part:FindFirstChild("AntiGravity") :: VectorForce,
		landedOn = nil,
		heldBy = nil,
		thrownBy = nil,
		thrownAt = 0,
		throwVelocity = Vector3.zero,
		hitDone = true,
	}
	records[part] = record
	updateAntiGravity(record)
	CollectionService:AddTag(part, DEBRIS_TAG)

	record.prompt.Triggered:Connect(function(player)
		local handler = DebrisService.onPromptTriggered
		if handler then
			handler(player, part)
		end
	end)
	part.Touched:Connect(function(hit)
		local handler = DebrisService.onDebrisTouched
		if handler and record.thrownBy and not record.hitDone then
			handler(record, hit)
		end
	end)
	return part
end

-- Called by ThrowService when a player grabs a piece. Removes it from any
-- platform's load immediately.
function DebrisService.markHeld(record: DebrisRecord, player: Player)
	setLanded(record, nil)
	record.heldBy = player
	record.thrownBy = nil
	record.hitDone = true
	record.prompt.Enabled = false
	record.part.CanCollide = false
	record.part.Massless = true
	updateAntiGravity(record)
end

function DebrisService.markReleased(record: DebrisRecord, thrower: Player?, velocity: Vector3?)
	record.heldBy = nil
	record.prompt.Enabled = true
	record.part.CanCollide = true
	record.part.Massless = false
	updateAntiGravity(record)
	if thrower and velocity then
		record.thrownBy = thrower
		record.thrownAt = os.clock()
		record.throwVelocity = velocity
		record.hitDone = false
	end
end

-- Which live platform is this position resting on, if any?
local function platformUnder(position: Vector3): Platform?
	for _, platform in Arena.platforms do
		if not platform.dropped and LoadService.isActive(platform) then
			local inside, height = Arena.isOver(platform, position)
			if inside and height >= -1 and height <= Config.LAND_HEIGHT_BAND then
				return platform
			end
		end
	end
	return nil
end

function DebrisService.scan()
	local killY = Arena.killY()
	local now = os.clock()
	for part, record in records do
		if not part.Parent then
			setLanded(record, nil)
			records[part] = nil
			continue
		end
		if record.heldBy then
			continue
		end
		local position = part.Position
		if position.Y < killY then
			DebrisService.destroy(part)
			continue
		end
		if record.thrownBy and now - record.thrownAt > Config.THROW_HIT_WINDOW then
			record.hitDone = true
		end

		local under = platformUnder(position)
		if record.landedOn and under ~= record.landedOn then
			-- Slid, rolled or got knocked off.
			setLanded(record, nil)
		end
		if not record.landedOn and under and part.AssemblyLinearVelocity.Magnitude <= Config.LAND_MAX_SPEED then
			record.thrownBy = nil
			record.hitDone = true
			setLanded(record, under)
		end
	end
end

local function spawnLoop(platform: Platform, myRound: number)
	while roundId == myRound and LoadService.isActive(platform) do
		task.wait(rng:NextNumber(Config.SPAWN_INTERVAL_MIN, Config.SPAWN_INTERVAL_MAX))
		if roundId ~= myRound or not LoadService.isActive(platform) then
			break
		end
		local offset = HexGeometry.randomLocalPoint(Config.PLATFORM_RADIUS, Config.SPAWN_EDGE_MARGIN, rng)
		local position = platform.topCFrame:PointToWorldSpace(Vector3.new(offset.X, Config.SPAWN_HEIGHT, offset.Y))
		DebrisService.spawnAt(position)
	end
end

function DebrisService.startRound(platforms: { Platform })
	roundId += 1
	for _, platform in platforms do
		task.spawn(spawnLoop, platform, roundId)
	end
end

-- Destroys every loose piece over a crushed platform's footprint.
function DebrisService.crushPlatform(platform: Platform)
	for part, record in records do
		if record.heldBy then
			continue
		end
		local inside = HexGeometry.containsWorld(platform.topCFrame, Config.PLATFORM_RADIUS, part.Position)
		if record.landedOn == platform or inside then
			DebrisService.destroy(part)
		end
	end
end

function DebrisService.stopRound()
	roundId += 1
	for part in records do
		DebrisService.destroy(part)
	end
end

return DebrisService
]=====])
add("ServerScriptService", "ModuleScript", "ThrowService", [=====[
--!strict
-- Pickup (ProximityPrompt) and throw (RemoteEvent). The client only sends an
-- aim point. Everything else (who holds what, where it launches from, how
-- fast, what it hits) is decided here.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("DebrisClear")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Ballistics = require(Shared.Ballistics)
local DebrisService = require(script.Parent.DebrisService)
local LoadService = require(script.Parent.LoadService)
local RateLimiter = require(script.Parent.RateLimiter)

type DebrisRecord = DebrisService.DebrisRecord

local ThrowService = {}

local holding: { [Player]: BasePart? } = {}
local holdWelds: { [Player]: WeldConstraint } = {}
local lastPickup: { [Player]: number } = {}
local lastThrow: { [Player]: number } = {}
local throwLimiter = RateLimiter.new(Config.MAX_REMOTE_RATE)

local throwRemote: RemoteEvent
local knockbackRemote: RemoteEvent

local function livingRoot(player: Player): (BasePart?, Humanoid?)
	local character = player.Character
	if not character then
		return nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or humanoid.Health <= 0 or not root then
		return nil, nil
	end
	return root, humanoid
end

local function isFiniteVector(v: Vector3): boolean
	for _, n in { v.X, v.Y, v.Z } do
		if n ~= n or math.abs(n) > 1e6 then
			return false
		end
	end
	return true
end

local function setHolding(player: Player, part: BasePart?)
	holding[player] = part
	player:SetAttribute("HoldingDebris", part ~= nil)
end

-- Drop whatever the player is holding in place (death, elimination, leaving).
function ThrowService.release(player: Player)
	local part = holding[player]
	local weld = holdWelds[player]
	holdWelds[player] = nil
	setHolding(player, nil)
	if weld then
		weld:Destroy()
	end
	if part and part.Parent then
		local record = DebrisService.get(part)
		if record then
			DebrisService.markReleased(record, nil, nil)
		end
		pcall(part.SetNetworkOwner, part, nil)
	end
end

function ThrowService.releaseAll()
	for player in holding do
		ThrowService.release(player)
	end
end

local function tryPickup(player: Player, part: BasePart)
	if not LoadService.isAlive(player) or holding[player] then
		return
	end
	local now = os.clock()
	if now - (lastPickup[player] or 0) < Config.PICKUP_COOLDOWN then
		return
	end
	local record = DebrisService.get(part)
	if not record or record.heldBy then
		return
	end
	local root = livingRoot(player)
	if not root then
		return
	end
	-- The prompt enforces range on the client; re-check with latency slack.
	if (root.Position - part.Position).Magnitude > Config.PICKUP_RANGE + Config.PICKUP_RANGE_TOLERANCE then
		return
	end
	lastPickup[player] = now

	DebrisService.markHeld(record, player)
	part.AssemblyLinearVelocity = Vector3.zero
	part.AssemblyAngularVelocity = Vector3.zero
	part.CFrame = root.CFrame * Config.HOLD_OFFSET
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part
	holdWelds[player] = weld
	setHolding(player, part)
end

local function onThrowRequest(player: Player, aimPoint: unknown)
	-- Validation: type, rate, state, then geometry.
	if typeof(aimPoint) ~= "Vector3" then
		return
	end
	local aim = aimPoint :: Vector3
	if not isFiniteVector(aim) or not throwLimiter:allow(player) then
		return
	end
	local now = os.clock()
	if now - (lastThrow[player] or 0) < Config.THROW_COOLDOWN then
		return
	end
	local part = holding[player]
	if not part or not LoadService.isAlive(player) then
		return
	end
	local record = DebrisService.get(part)
	local root = livingRoot(player)
	if not record or record.heldBy ~= player or not root then
		return
	end
	lastThrow[player] = now

	-- Launch from the server's view of the hold position, never a client value.
	local origin = (root.CFrame * Config.HOLD_OFFSET).Position
	local toAim = aim - origin
	if toAim.Magnitude > Config.THROW_MAX_AIM_DISTANCE then
		aim = origin + toAim.Unit * Config.THROW_MAX_AIM_DISTANCE
	end
	local velocity = Ballistics.solve(origin, aim, Config.THROW_SPEED)

	local weld = holdWelds[player]
	holdWelds[player] = nil
	setHolding(player, nil)
	if weld then
		weld:Destroy()
	end
	part.CFrame = CFrame.new(origin) * part.CFrame.Rotation
	DebrisService.markReleased(record, player, velocity)
	pcall(part.SetNetworkOwner, part, nil)
	part.AssemblyLinearVelocity = velocity

	-- LinearVelocity drives the launch briefly, then gravity takes over.
	local attachment = part:FindFirstChild("Center") :: Attachment
	local drive = Instance.new("LinearVelocity")
	drive.Attachment0 = attachment
	drive.RelativeTo = Enum.ActuatorRelativeTo.World
	drive.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	drive.VectorVelocity = velocity
	drive.MaxForce = math.huge
	drive.Parent = part
	task.delay(Config.THROW_BOOST_TIME, function()
		drive:Destroy()
	end)
end

-- Body hit: knock the victim along the throw direction. No load moves here;
-- only debris that comes to rest on a platform counts.
local function onDebrisTouched(record: DebrisRecord, hit: BasePart)
	local character = hit:FindFirstAncestorOfClass("Model")
	local victim = character and Players:GetPlayerFromCharacter(character)
	if not victim or victim == record.thrownBy then
		return
	end
	if os.clock() - record.thrownAt > Config.THROW_HIT_WINDOW then
		record.hitDone = true
		return
	end
	local root = livingRoot(victim)
	if not root then
		return
	end
	record.hitDone = true

	local flat = Vector3.new(record.throwVelocity.X, 0, record.throwVelocity.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(root.Position.X - record.part.Position.X, 0, root.Position.Z - record.part.Position.Z)
	end
	local direction = if flat.Magnitude > 0.01 then flat.Unit else Vector3.xAxis
	local knockback = direction * Config.KNOCKBACK_SPEED + Vector3.yAxis * Config.KNOCKBACK_UP
	-- The victim's client owns its character physics, so it applies the impulse.
	knockbackRemote:FireClient(victim, knockback, Config.KNOCKBACK_STUN)
end

function ThrowService.init()
	throwRemote = Remotes.get("ThrowDebris")
	knockbackRemote = Remotes.get("Knockback")

	throwRemote.OnServerEvent:Connect(onThrowRequest)
	DebrisService.onPromptTriggered = tryPickup
	DebrisService.onDebrisTouched = onDebrisTouched

	LoadService.onEliminated(function(player)
		ThrowService.release(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		ThrowService.release(player)
		lastPickup[player] = nil
		lastThrow[player] = nil
		throwLimiter:forget(player)
	end)
end

return ThrowService
]=====])
add("ServerScriptService", "ModuleScript", "RateLimiter", [=====[
--!strict
-- Per-player token bucket for remote traffic.

local RateLimiter = {}
RateLimiter.__index = RateLimiter

type Bucket = { tokens: number, stamp: number }

export type RateLimiter = typeof(setmetatable(
	{} :: { rate: number, buckets: { [Player]: Bucket } },
	RateLimiter
))

function RateLimiter.new(perSecond: number): RateLimiter
	return setmetatable({ rate = perSecond, buckets = {} }, RateLimiter)
end

function RateLimiter.allow(self: RateLimiter, player: Player): boolean
	local now = os.clock()
	local bucket = self.buckets[player]
	if not bucket then
		bucket = { tokens = self.rate, stamp = now }
		self.buckets[player] = bucket
	end
	bucket.tokens = math.min(self.rate, bucket.tokens + (now - bucket.stamp) * self.rate)
	bucket.stamp = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

function RateLimiter.forget(self: RateLimiter, player: Player)
	self.buckets[player] = nil
end

return RateLimiter
]=====])
